<%- include('../layouts/main', { section: 'top', pageTitle }) %>

<div class="dashboard-shell">
  <%- include('../partials/adminSidebar', { activePage }) %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div class="flex items-center gap-3 min-w-0">
        <button type="button" id="sidebarOpenBtn" class="lg:hidden p-2 -ml-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5" aria-label="Open menu">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <p class="text-xs text-slate-400 truncate">Admin Portal / Manage Students</p>
      </div>
      <a href="/admin/rankings" class="btn-outline px-3.5 py-1.5 text-xs">View Rankings</a>
    </header>

    <main class="flex-1 p-5 sm:p-7 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white">Manage Student Athletes</h1>
          <p class="mt-1 text-sm text-slate-400">Filter registered athletes by sport, department, or student ID.</p>
        </div>

        <!-- Search & Filters -->
        <div class="flex flex-wrap items-center gap-3">
          <input
            type="search"
            id="adminStudentSearch"
            placeholder="Search name or ID..."
            class="track-input px-3.5 py-2 text-xs w-52"
          />
          <select id="adminStudentSportFilter" class="track-select px-3.5 py-2 text-xs">
            <option value="All">All Sports</option>
            <% sports.forEach((sp) => { %>
              <option value="<%= sp.name %>"><%= sp.name %></option>
            <% }) %>
          </select>
          <select id="adminStudentDeptFilter" class="track-select px-3.5 py-2 text-xs">
            <option value="All">All Departments</option>
            <% departments.forEach((dept) => { %>
              <option value="<%= dept %>"><%= dept %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Students Table -->
      <div class="track-card overflow-hidden">
        <div class="track-table-wrap">
          <table class="track-table" id="adminStudentsTable">
            <thead>
              <tr>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Department</th>
                <th>Academic Year</th>
                <th>Registered Sport</th>
                <th class="text-right">Matches Played</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach((student) => { %>
                <tr
                  class="admin-student-row"
                  data-sport="<%= student.primarySport %>"
                  data-dept="<%= student.department %>"
                  data-search="<%= (student.id + ' ' + student.name + ' ' + student.department + ' ' + student.primarySport).toLowerCase() %>"
                >
                  <td class="font-mono-num text-xs text-slate-400"><%= student.id %></td>
                  <td class="font-semibold text-white"><%= student.name %></td>
                  <td><%= student.department %></td>
                  <td class="text-slate-300"><%= student.year %></td>
                  <td class="text-blue-400 font-medium"><%= student.primarySport %></td>
                  <td class="text-right font-mono-num"><%= student.matchesPlayed %></td>
                  <td>
                    <span class="text-xs font-semibold <%= student.status === 'Active' ? 'text-emerald-400' : 'text-amber-400' %>">
                      <%= student.status %>
                    </span>
                  </td>
                  <td class="text-right">
                    <a href="/student/profile?id=<%= student.id %>" class="btn-outline px-3 py-1 text-xs">
                      View Profile
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../layouts/main', { section: 'bottom' }) %>
