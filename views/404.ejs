<%- include('layouts/main', { section: 'top', pageTitle }) %>
<%- include('partials/navbar', { activeNav: '' }) %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-24 text-center space-y-6">
  <p class="text-sm font-mono-num text-blue-400">Error 404</p>
  <h1 class="text-4xl sm:text-5xl font-bold text-white">Page Not Found</h1>
  <p class="text-base text-slate-400 max-w-lg mx-auto">
    The route <span class="font-mono-num text-slate-200"><%= requestedUrl %></span> does not match any active page in Track.
  </p>
  <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
    <a href="/" class="btn-electric px-5 py-2.5 text-sm">Return Home</a>
    <a href="/student/dashboard" class="btn-outline px-5 py-2.5 text-sm">Student Portal</a>
    <a href="/admin/dashboard" class="btn-outline px-5 py-2.5 text-sm">Admin Portal</a>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('layouts/main', { section: 'bottom' }) %>
