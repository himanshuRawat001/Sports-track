<div id="sidebarOverlay" class="sidebar-overlay" aria-hidden="true"></div>

<aside id="portalSidebar" class="dashboard-sidebar" aria-label="Student portal navigation">
  <!-- Brand Header -->
  <div class="h-16 px-5 flex items-center justify-between border-b border-white/10 shrink-0">
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold text-white font-display whitespace-nowrap">
      <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white">
        <i data-lucide="activity" class="w-4 h-4"></i>
      </span>
      <span>Track</span>
    </a>
    <button type="button" id="sidebarCloseBtn" class="lg:hidden p-1.5 text-slate-400 hover:text-white" aria-label="Close sidebar">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <!-- Student Portal Navigation -->
  <div class="flex-1 overflow-y-auto px-3 py-5 space-y-6">
    <div>
      <p class="px-3 mb-2 text-xs font-medium text-slate-500">Student Portal</p>
      <nav class="space-y-1">
        <a href="/student/dashboard" class="sidebar-link <%= activePage === 'dashboard' ? 'is-active' : '' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
          <span>Dashboard</span>
        </a>
        <a href="/student/sports" class="sidebar-link <%= activePage === 'sports' ? 'is-active' : '' %>">
          <i data-lucide="trophy" class="w-4 h-4 shrink-0"></i>
          <span>Explore Sports</span>
        </a>
        <a href="/student/matches" class="sidebar-link <%= activePage === 'matches' ? 'is-active' : '' %>">
          <i data-lucide="calendar-days" class="w-4 h-4 shrink-0"></i>
          <span>Matches</span>
        </a>
        <a href="/student/results" class="sidebar-link <%= activePage === 'results' ? 'is-active' : '' %>">
          <i data-lucide="award" class="w-4 h-4 shrink-0"></i>
          <span>Match Results</span>
        </a>
        <a href="/student/leaderboard" class="sidebar-link <%= activePage === 'leaderboard' ? 'is-active' : '' %>">
          <i data-lucide="bar-chart-3" class="w-4 h-4 shrink-0"></i>
          <span>Leaderboard</span>
        </a>
        <a href="/student/profile" class="sidebar-link <%= activePage === 'profile' ? 'is-active' : '' %>">
          <i data-lucide="user" class="w-4 h-4 shrink-0"></i>
          <span>My Profile</span>
        </a>
      </nav>
    </div>

    <div class="pt-4 border-t border-white/10">
      <p class="px-3 mb-2 text-xs font-medium text-slate-500">Switch View</p>
      <nav class="space-y-1">
        <a href="/" class="sidebar-link">
          <i data-lucide="globe" class="w-4 h-4 shrink-0"></i>
          <span>Public Home</span>
        </a>
        <a href="/admin/dashboard" class="sidebar-link">
          <i data-lucide="shield-check" class="w-4 h-4 shrink-0"></i>
          <span>Admin Portal</span>
        </a>
      </nav>
    </div>
  </div>

  <!-- Active Demo Profile Summary -->
  <div class="p-4 border-t border-white/10 shrink-0">
    <a href="/student/profile" class="flex items-center gap-3 p-2 rounded-lg hover:bg-white/5 transition-colors">
      <img
        src="/images/aarav-sharma.jpg"
        alt="Aarav Sharma"
        referrerpolicy="no-referrer"
        class="w-9 h-9 rounded-full object-cover border border-white/15 shrink-0"
      />
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white truncate">Aarav Sharma</p>
        <p class="text-xs text-slate-400 truncate">STU001 · MCA Year 2</p>
      </div>
    </a>
  </div>
</aside>
