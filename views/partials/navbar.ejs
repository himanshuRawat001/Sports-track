<header class="sticky top-0 z-40 border-b border-white/10 bg-[#070D19]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8">
    <!-- Zone 1: Brand Wordmark -->
    <a href="/" class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-white whitespace-nowrap shrink-0 font-display">
      <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white">
        <i data-lucide="activity" class="w-4 h-4"></i>
      </span>
      <span>Track</span>
    </a>

    <!-- Zone 2: Primary Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-medium" aria-label="Main navigation">
      <a href="/" class="nav-text-link <%= activeNav === 'home' ? 'is-active' : '' %>">Home</a>
      <a href="/student/sports" class="nav-text-link">Explore Sports</a>
      <a href="/student/matches" class="nav-text-link">Matches</a>
      <a href="/student/leaderboard" class="nav-text-link">Leaderboard</a>
      <a href="/admin/dashboard" class="nav-text-link">Admin Portal</a>
    </nav>

    <!-- Zone 3: Primary Portal Action + Mobile Menu Toggle -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="/student/dashboard" class="btn-electric px-4 py-2 text-sm">
        <span>Student Portal</span>
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>

      <button
        type="button"
        id="mobileNavToggle"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobileNavDrawer" class="hidden lg:hidden border-t border-white/10 bg-[#0B1324] px-4 py-4">
    <nav class="flex flex-col gap-2 text-sm font-medium" aria-label="Mobile navigation">
      <a href="/" class="px-3 py-2.5 rounded-lg text-white hover:bg-white/5">Home</a>
      <a href="/student/sports" class="px-3 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5">Explore Sports</a>
      <a href="/student/matches" class="px-3 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5">Matches</a>
      <a href="/student/leaderboard" class="px-3 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5">Leaderboard</a>
      <div class="border-t border-white/10 my-2"></div>
      <a href="/student/dashboard" class="px-3 py-2.5 rounded-lg text-blue-400 hover:bg-blue-500/10">Student Portal</a>
      <a href="/admin/dashboard" class="px-3 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5">Admin Portal</a>
    </nav>
  </div>
</header>
