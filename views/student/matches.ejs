<%- include('../layouts/main', { section: 'top', pageTitle }) %>

<div class="dashboard-shell">
  <%- include('../partials/studentSidebar', { activePage }) %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div class="flex items-center gap-3 min-w-0">
        <button type="button" id="sidebarOpenBtn" class="lg:hidden p-2 -ml-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5" aria-label="Open menu">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <p class="text-xs text-slate-400 truncate">Student Portal / Matches &amp; Fixtures</p>
      </div>
      <a href="/student/results" class="btn-outline px-3.5 py-1.5 text-xs">Completed Results</a>
    </header>

    <main class="flex-1 p-5 sm:p-7 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white">Matches &amp; Tournament Schedule</h1>
          <p class="mt-1 text-sm text-slate-400">Track ongoing live matches, upcoming fixtures, and completed rounds.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <select id="matchSportFilter" class="track-select px-3.5 py-2 text-xs">
            <option value="All">All Sports</option>
            <% sports.forEach((s) => { %>
              <option value="<%= s.name %>"><%= s.name %></option>
            <% }) %>
          </select>
          <input
            type="search"
            id="matchSearchInput"
            placeholder="Search team or venue..."
            class="track-input px-3.5 py-2 text-xs w-52"
          />
        </div>
      </div>

      <!-- Status Tabs -->
      <div class="flex flex-wrap items-center gap-2" role="tablist">
        <% ['All', 'Ongoing', 'Upcoming', 'Completed'].forEach((st, idx) => { %>
          <button
            type="button"
            class="match-status-tab px-4 py-2 text-xs font-medium rounded-lg border transition-colors whitespace-nowrap <%= idx === 0 ? 'bg-blue-600 text-white border-blue-500' : 'bg-[#111B30] text-slate-300 border-white/10 hover:text-white' %>"
            data-status="<%= st %>"
          >
            <%= st %>
          </button>
        <% }) %>
      </div>

      <!-- Matches Grid -->
      <div id="studentMatchesGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <% allMatches.forEach((match) => { %>
          <article
            class="track-card p-6 flex flex-col justify-between gap-4 student-match-card"
            data-status="<%= match.status %>"
            data-sport="<%= match.sport %>"
            data-search="<%= (match.teamA + ' ' + match.teamB + ' ' + match.venue + ' ' + match.sport).toLowerCase() %>"
          >
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs text-slate-400">
                <span class="font-medium text-slate-200"><%= match.sport %></span>
                <span class="mx-1.5" aria-hidden="true">&middot;</span>
                <span><%= match.round %></span>
              </p>
              <span class="text-xs font-semibold <%= match.status === 'Ongoing' ? 'text-blue-400' : (match.status === 'Upcoming' ? 'text-amber-400' : 'text-emerald-400') %>">
                <%= match.status === 'Ongoing' ? 'Ongoing Live' : match.status %>
              </span>
            </div>

            <div class="flex items-center justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-base sm:text-lg font-bold text-white truncate"><%= match.teamA %></h2>
                <p class="text-xs text-slate-500 my-0.5">vs</p>
                <h2 class="text-base sm:text-lg font-bold text-white truncate"><%= match.teamB %></h2>
              </div>
              <div class="text-right shrink-0">
                <p class="text-sm font-semibold text-blue-400 font-mono-num"><%= match.scoreDisplay %></p>
                <% if (match.winner && match.winner !== 'TBD') { %>
                  <p class="text-xs text-emerald-400 mt-1">Winner: <%= match.winner %></p>
                <% } %>
              </div>
            </div>

            <div class="pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
              <span><%= match.venue %></span>
              <span class="font-mono-num"><%= match.formattedDate %> &middot; <%= match.time %></span>
            </div>
          </article>
        <% }) %>
      </div>

      <div id="studentMatchesEmpty" class="hidden track-card p-10 text-center">
        <p class="text-sm text-slate-300">No matches found for the selected filter.</p>
      </div>
    </main>
  </div>
</div>

<%- include('../layouts/main', { section: 'bottom' }) %>
